  "info": {
    "_postman_id": "14423eba-6b18-44a6-b8cb-17c34004616b",
    "name": "Spurwing Appointment Scheduling Appointments API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Spurwing is an enterprise-grade appointment scheduling, calendar, and time-management API. The REST API exposes appointment types (services), provider availability (days and time slots), client booking, and appointment management (group appointments, listing, and cancellation). Public read/booking operations are scoped by a public Provider ID; private operations are authorized with a Bearer API key. Spurwing joined Healthie; documented endpoints below are drawn from Spurwing's official open-source client libraries (Python, NodeJS, JavaScript, Java).\n\nContact Support:\n Name: Spurwing Support\n Email: support@spurwing.io",
      "type": "text/plain"
    }
  }
