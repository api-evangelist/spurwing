{
  "info": {
    "name": "Spurwing Appointment Scheduling API",
    "description": "Spurwing enterprise appointment scheduling REST API. Public availability and booking operations are scoped by a public Provider ID; private operations use a Bearer API key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.spurwing.io/api/v2"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "providerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Services",
      "item": [
        {
          "name": "List appointment types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointment_types.json?provider_id={{providerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["appointment_types.json"],
              "query": [
                { "key": "provider_id", "value": "{{providerId}}" },
                { "key": "page_size", "value": "", "disabled": true },
                { "key": "offset", "value": "", "disabled": true }
              ]
            },
            "description": "Lists the appointment types (services) configured on a provider's public calendar."
          }
        }
      ]
    },
    {
      "name": "Availability",
      "item": [
        {
          "name": "List available days",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/days_available.json?provider_id={{providerId}}&appointment_type_id=",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "days_available.json"],
              "query": [
                { "key": "provider_id", "value": "{{providerId}}" },
                { "key": "appointment_type_id", "value": "" },
                { "key": "date_from_month", "value": "", "disabled": true },
                { "key": "organization_level", "value": "", "disabled": true },
                { "key": "timezone", "value": "", "disabled": true }
              ]
            },
            "description": "Returns the days a provider has availability for a given appointment type."
          }
        },
        {
          "name": "List available slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/slots_available.json?provider_id={{providerId}}&appointment_type_id=&start_date=&end_date=",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "slots_available.json"],
              "query": [
                { "key": "provider_id", "value": "{{providerId}}" },
                { "key": "appointment_type_id", "value": "" },
                { "key": "start_date", "value": "" },
                { "key": "end_date", "value": "" },
                { "key": "organization_level", "value": "", "disabled": true },
                { "key": "timezone", "value": "", "disabled": true }
              ]
            },
            "description": "Returns bookable time slots for a provider and appointment type within a date range."
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Complete a booking",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "provider_id", "value": "{{providerId}}" },
                { "key": "appointment_type_id", "value": "" },
                { "key": "email", "value": "" },
                { "key": "first_name", "value": "" },
                { "key": "last_name", "value": "" },
                { "key": "date", "value": "" },
                { "key": "timezone", "value": "", "disabled": true },
                { "key": "contact_type", "value": "", "disabled": true },
                { "key": "appointment_id", "value": "", "disabled": true },
                { "key": "appointment_location_id", "value": "", "disabled": true },
                { "key": "video_chat_url", "value": "", "disabled": true }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/complete_booking.json",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "complete_booking.json"]
            },
            "description": "Creates a booking for a client. Pass appointment_id to add an attendee to an existing group appointment."
          }
        },
        {
          "name": "Create group appointment",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "provider_id", "value": "{{providerId}}" },
                { "key": "appointment_type_id", "value": "" },
                { "key": "datetime", "value": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"]
            },
            "description": "Creates a group appointment. Requires a Bearer API key."
          }
        },
        {
          "name": "List appointments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments?page_size=1000&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["appointments"],
              "query": [
                { "key": "page_size", "value": "1000" },
                { "key": "offset", "value": "0" },
                { "key": "appointment_category", "value": "", "disabled": true },
                { "key": "load_attendees", "value": "", "disabled": true },
                { "key": "load_providers", "value": "", "disabled": true },
                { "key": "load_appointment_type", "value": "", "disabled": true }
              ]
            },
            "description": "Lists the authorized account's appointments. Requires a Bearer API key."
          }
        },
        {
          "name": "Cancel an appointment",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointments/:appointment_id",
              "host": ["{{baseUrl}}"],
              "path": ["appointments", ":appointment_id"],
              "variable": [
                { "key": "appointment_id", "value": "" }
              ]
            },
            "description": "Cancels and deletes an appointment by id. Requires a Bearer API key."
          }
        }
      ]
    }
  ]
}
